prefix=${pcfiledir}/@JINJA2CPP_PC_PREFIX_REL@
exec_prefix=${prefix}
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@
# The built-in big-integer backend: none or boost
bigint=@JINJA2CPP_WITH_BIGINT@

Name: jinja2cpp
Description: C++ implementation of the Jinja2 template engine
Version: @PROJECT_VERSION@
Requires.private: @JINJA2CPP_PC_REQUIRES_PRIVATE@
Libs: -L${libdir} -ljinja2cpp
Libs.private: @JINJA2CPP_PC_LIBS_PRIVATE@
Cflags: -I${includedir} @JINJA2CPP_PC_CFLAGS@

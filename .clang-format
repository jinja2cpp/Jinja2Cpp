# Derived from the committed code (clang-format 18-23): each option below is the value
# that minimises the number of lines clang-format would touch in src/, include/ and test/.
# Hand-wrapped lines are the norm here, so ColumnLimit is 0 (keep the author's breaks);
# moving to a hard limit is a separate, mechanical reformat (see docs/tasks/).
BasedOnStyle: Microsoft
Standard: c++14
UseTab: Never
IndentWidth: 4
TabWidth: 8
ColumnLimit: 0
AccessModifierOffset: -4
ConstructorInitializerIndentWidth: 4
NamespaceIndentation: None
PointerAlignment: Left
BreakBeforeBraces: Custom
BraceWrapping:
  AfterCaseLabel: true
  AfterClass: true
  AfterControlStatement: true
  AfterFunction: true
  AfterNamespace: true
  AfterStruct: true
  AfterUnion: true
  BeforeCatch: true
  BeforeElse: true
  SplitEmptyFunction: false
AlignAfterOpenBracket: Align
AlignEscapedNewlines: DontAlign
AllowAllParametersOfDeclarationOnNextLine: false
AllowShortBlocksOnASingleLine: Always
AllowShortCaseLabelsOnASingleLine: true
AllowShortFunctionsOnASingleLine: All
AlwaysBreakAfterReturnType: None
BinPackParameters: false
BreakBeforeBinaryOperators: NonAssignment
BreakConstructorInitializers: BeforeComma
BreakInheritanceList: BeforeComma
Cpp11BracedListStyle: false
EmptyLineBeforeAccessModifier: Leave
FixNamespaceComments: false
MaxEmptyLinesToKeep: 3
PackConstructorInitializers: CurrentLine
PenaltyReturnTypeOnItsOwnLine: 0
ReflowComments: false
SortIncludes: Never
SpaceAfterTemplateKeyword: false

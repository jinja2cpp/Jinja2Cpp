# The setup step of the jinja2cpp_parity_oracle fixture (cmake/parity_oracle.cmake): renders the
# parity corpus with the other oracle into OUT.
#   cmake -DPYTHON=<interpreter> -DGENERATE=<generate.py> -DOUT=<dir> [-DREQUIREMENTS=<file>] -P parity_oracle_generate.cmake
# With REQUIREMENTS, PYTHON is the base of a venv in OUT/venv that pip fills from that file. The venv
# is rebuilt when the file changes; delete OUT/venv to pick up a new commit of a branch requirement.
foreach (_var PYTHON GENERATE OUT)
    if (NOT ${_var})
        message(FATAL_ERROR "parity_oracle_generate.cmake needs -D${_var}=...")
    endif ()
endforeach ()

set(_python "${PYTHON}")
if (REQUIREMENTS)
    set(_venv ${OUT}/venv)
    if (WIN32)
        set(_python ${_venv}/Scripts/python.exe)
    else ()
        set(_python ${_venv}/bin/python)
    endif ()
    set(_stamp ${_venv}/jinja2cpp-requirements.txt)
    set(_fresh FALSE)
    if (EXISTS ${_stamp} AND EXISTS ${_python})
        file(READ ${_stamp} _installed)
        file(READ ${REQUIREMENTS} _wanted)
        if (_installed STREQUAL _wanted)
            set(_fresh TRUE)
        endif ()
    endif ()
    if (NOT _fresh)
        message(STATUS "Creating ${_venv} with ${PYTHON}")
        execute_process(COMMAND "${PYTHON}" -m venv --clear ${_venv} RESULT_VARIABLE _result)
        if (NOT _result EQUAL 0)
            message(FATAL_ERROR "python -m venv failed (${_result})")
        endif ()
        execute_process(COMMAND "${_python}" -m pip install --disable-pip-version-check -r ${REQUIREMENTS} RESULT_VARIABLE _result)
        if (NOT _result EQUAL 0)
            message(FATAL_ERROR "pip install -r ${REQUIREMENTS} failed (${_result}); the venv oracle needs network access to the package index")
        endif ()
        configure_file(${REQUIREMENTS} ${_stamp} COPYONLY)
    endif ()
endif ()

execute_process(COMMAND "${_python}" -c "import jinja2" RESULT_VARIABLE _result OUTPUT_QUIET ERROR_QUIET)
if (NOT _result EQUAL 0)
    message(FATAL_ERROR "${_python} cannot import jinja2: install it there, or use JINJA2CPP_TEST_ORACLE=venv")
endif ()
execute_process(COMMAND "${_python}" ${GENERATE} --out ${OUT} --any-version RESULT_VARIABLE _result)
if (NOT _result EQUAL 0)
    message(FATAL_ERROR "generate.py --out ${OUT} failed (${_result})")
endif ()

# Config file for the installed Jinja2C++ package (docs/tasks/0068). The targets file is
# generated by install(EXPORT); this file only finds what that file refers to.
@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

set(jinja2cpp_SHARED @JINJA2CPP_BUILD_SHARED_BOOL@)
set(jinja2cpp_DEPS_MODE "@JINJA2CPP_DEPS_MODE@")
# The built-in big-integer backend: none or boost (GetBuiltinBigIntBackend(), docs/tasks/0272)
set(jinja2cpp_BIGINT "@JINJA2CPP_WITH_BIGINT@")

# Public: <nonstd/expected.hpp> is included by the public headers
find_dependency(expected-lite CONFIG HINTS "${PACKAGE_PREFIX_DIR}")
# Private link dependencies: only a static library (or one linked against shared
# dependencies) passes them on to its consumers
if (@JINJA2CPP_EXPORT_PRIVATE_DEPS@)
    include("${CMAKE_CURRENT_LIST_DIR}/jinja2cpp-config-deps.cmake")
endif ()

include("${CMAKE_CURRENT_LIST_DIR}/jinja2cpp-targets.cmake")

# 1.x consumers linked the un-namespaced target
if (NOT TARGET jinja2cpp)
    add_library(jinja2cpp ALIAS jinja2cpp::jinja2cpp)
endif ()

# The JSON bindings and the big-integer adapter are components (docs/tasks/0311):
#   find_package(jinja2cpp COMPONENTS nlohmann_json) gives jinja2cpp::nlohmann_json.
# Every component is installed; its dependency is looked for only when it is asked for.
set(_jinja2cpp_known_components @JINJA2CPP_COMPONENTS@)
foreach (_jinja2cpp_comp IN LISTS ${CMAKE_FIND_PACKAGE_NAME}_FIND_COMPONENTS)
    set(${CMAKE_FIND_PACKAGE_NAME}_${_jinja2cpp_comp}_FOUND FALSE)
    if (NOT _jinja2cpp_comp IN_LIST _jinja2cpp_known_components)
        set(_jinja2cpp_why "jinja2cpp has no component '${_jinja2cpp_comp}'; it has: ${_jinja2cpp_known_components}")
    else ()
        include("${CMAKE_CURRENT_LIST_DIR}/jinja2cpp-${_jinja2cpp_comp}-deps.cmake")
        if (_jinja2cpp_component_missing)
            set(_jinja2cpp_why "jinja2cpp component '${_jinja2cpp_comp}' needs ${_jinja2cpp_component_missing}, which was not found")
        else ()
            if (NOT TARGET jinja2cpp::${_jinja2cpp_comp})
                include("${CMAKE_CURRENT_LIST_DIR}/jinja2cpp-${_jinja2cpp_comp}-targets.cmake")
                set_property(TARGET jinja2cpp::${_jinja2cpp_comp} APPEND PROPERTY
                    INTERFACE_LINK_LIBRARIES ${_jinja2cpp_component_links})
            endif ()
            set(${CMAKE_FIND_PACKAGE_NAME}_${_jinja2cpp_comp}_FOUND TRUE)
            set(_jinja2cpp_why "")
        endif ()
    endif ()
    if (_jinja2cpp_why)
        if (${CMAKE_FIND_PACKAGE_NAME}_FIND_REQUIRED_${_jinja2cpp_comp})
            string(APPEND ${CMAKE_FIND_PACKAGE_NAME}_NOT_FOUND_MESSAGE "${_jinja2cpp_why}. ")
        elseif (NOT ${CMAKE_FIND_PACKAGE_NAME}_FIND_QUIETLY)
            message(STATUS "${_jinja2cpp_why}")
        endif ()
    endif ()
endforeach ()
unset(_jinja2cpp_comp)
unset(_jinja2cpp_why)
unset(_jinja2cpp_component_missing)
unset(_jinja2cpp_component_links)
unset(_jinja2cpp_known_components)

check_required_components(${CMAKE_FIND_PACKAGE_NAME})

#define JINJA2CPP_VERSION ((JINJA2CPP_VERSION_MAJOR * 10000) + (JINJA2CPP_VERSION_MINOR * 100) + JINJA2CPP_VERSION_PATCH)
#define JINJA2CPP_VERSION_STRING "@PROJECT_VERSION@"
// NOLINTEND(modernize-macro-to-enum)


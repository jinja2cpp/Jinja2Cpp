# clang-tidy configuration (proposal, docs/tasks/0054). Measured with clang-tidy 22.1.8
# against master b0991e3 at C++14; per-check hit counts and the reasoning for every
# disabled check are in docs/tasks/0054-clang-tidy-adoption.md.
#
# Run at the minimum supported standard so every suggested fix compiles there: C++14 in
# 1.x, C++17 from 2.0 (docs/tasks/0070, whose PR switches CI to 17). Checks whose fixes
# need C++20 or C++23 are off below, so clangd in a C++20/23 build does not suggest them.
# Aliases are disabled in favour of their primary check so that a hit is reported once.
# Braces around single statements are required, but enforced by .clang-format
# (InsertBraces), so readability-braces-around-statements stays off here.
Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-crtp-constructor-accessibility,
  clang-analyzer-*,
  concurrency-*,
  -concurrency-mt-unsafe,
  cppcoreguidelines-*,
  -cppcoreguidelines-avoid-c-arrays,
  -cppcoreguidelines-avoid-const-or-ref-data-members,
  -cppcoreguidelines-avoid-do-while,
  -cppcoreguidelines-avoid-magic-numbers,
  -cppcoreguidelines-avoid-non-const-global-variables,
  -cppcoreguidelines-c-copy-assignment-signature,
  -cppcoreguidelines-explicit-virtual-functions,
  -cppcoreguidelines-macro-to-enum,
  -cppcoreguidelines-macro-usage,
  -cppcoreguidelines-narrowing-conversions,
  -cppcoreguidelines-noexcept-*,
  -cppcoreguidelines-non-private-member-variables-in-classes,
  -cppcoreguidelines-owning-memory,
  -cppcoreguidelines-pro-bounds-*,
  -cppcoreguidelines-pro-type-const-cast,
  -cppcoreguidelines-pro-type-reinterpret-cast,
  -cppcoreguidelines-pro-type-static-cast-downcast,
  -cppcoreguidelines-pro-type-union-access,
  -cppcoreguidelines-pro-type-vararg,
  -cppcoreguidelines-use-default-member-init,
  -cppcoreguidelines-use-enum-class,
  google-explicit-constructor,
  misc-*,
  -misc-include-cleaner,
  -misc-multiple-inheritance,
  -misc-no-recursion,
  -misc-non-private-member-variables-in-classes,
  -misc-use-internal-linkage,
  modernize-*,
  -modernize-avoid-c-arrays,
  -modernize-return-braced-init-list,
  -modernize-use-designated-initializers,
  -modernize-use-trailing-return-type,
  -modernize-use-constraints,
  -modernize-use-integer-sign-comparison,
  -modernize-use-ranges,
  -modernize-use-starts-ends-with,
  -modernize-use-std-format,
  -modernize-use-std-numbers,
  -modernize-use-std-print,
  performance-*,
  -performance-enum-size,
  portability-*,
  readability-*,
  -readability-avoid-nested-conditional-operator,
  -readability-braces-around-statements,
  -readability-container-contains,
  -readability-identifier-length,
  -readability-identifier-naming,
  -readability-magic-numbers,
  -readability-named-parameter,
  -readability-redundant-casting,
  -readability-redundant-typename

# Only the project's own headers; never the FetchContent cache (an unfiltered -fix
# rewrites Boost and fmt) or the vendored files .clang-format-ignore also skips.
HeaderFilterRegex: '/(include/jinja2cpp|src)/'
ExcludeHeaderFilterRegex: '(_deps|jinja2cpp-deps|/polymorphic_value/|robin_hood\.h|lexertk\.h|unicode_tables\.h)'
FormatStyle: file
# The ratchet: a check enters this list once a batch has cleaned it from the whole tree,
# so the pull-request job then fails on a new hit (docs/tasks/0054).
WarningsAsErrors: >
  bugprone-*,
  clang-analyzer-*,
  cppcoreguidelines-init-variables,
  cppcoreguidelines-pro-type-member-init,
  cppcoreguidelines-missing-std-forward,
  cppcoreguidelines-prefer-member-initializer,
  cppcoreguidelines-rvalue-reference-param-not-moved,
  cppcoreguidelines-special-member-functions,
  google-explicit-constructor,
  misc-use-anonymous-namespace,
  modernize-concat-nested-namespaces,
  modernize-pass-by-value,
  modernize-type-traits,
  modernize-use-bool-literals,
  modernize-use-emplace,
  modernize-use-equals-default,
  modernize-use-nodiscard,
  modernize-use-override,
  modernize-use-using,
  performance-move-const-arg,
  performance-noexcept-move-constructor,
  performance-unnecessary-copy-initialization,
  performance-unnecessary-value-param,
  readability-container-data-pointer,
  readability-convert-member-functions-to-static,
  readability-else-after-return,
  readability-implicit-bool-conversion,
  readability-isolate-declaration,
  readability-math-missing-parentheses,
  readability-qualified-auto,
  readability-redundant-access-specifiers,
  readability-redundant-string-cstr,
  readability-simplify-boolean-expr,
  readability-uppercase-literal-suffix

CheckOptions:
  # `if (ptr)` and `if (count)` are the house idiom; flag only the surprising conversions.
  readability-implicit-bool-conversion.AllowPointerConditions: true
  readability-implicit-bool-conversion.AllowIntegerConditions: true
  # Score 25 is the upstream default; 35 functions exceed it today and carry a
  # NOLINT with their score until they are split (docs/tasks/0054).
  readability-function-cognitive-complexity.Threshold: 25
  readability-function-cognitive-complexity.IgnoreMacros: true
  readability-function-cognitive-complexity.DescribeBasicIncrements: false
  # A lone `virtual ~Base() = default;` does not need the other four.
  cppcoreguidelines-special-member-functions.AllowSoleDefaultDtor: true
  cppcoreguidelines-special-member-functions.AllowMissingMoveFunctionsWhenCopyIsDeleted: true
  # const locals only: const by-value parameters and `T* const` add noise, not safety.
  misc-const-correctness.AnalyzeValues: false
  misc-const-correctness.WarnPointersAsValues: false
  # Naming conventions as the code already uses them, for when the check is switched on
  # (src/ only; public API names such as Value::asString stay as they are).
  readability-identifier-naming.ClassCase: CamelCase
  readability-identifier-naming.StructCase: CamelCase
  readability-identifier-naming.EnumCase: CamelCase
  readability-identifier-naming.EnumConstantCase: CamelCase
  readability-identifier-naming.FunctionCase: CamelCase
  readability-identifier-naming.MethodCase: CamelCase
  readability-identifier-naming.MethodIgnoredRegexp: '^(begin|end|cbegin|cend|rbegin|rend|size|empty|clear|insert|emplace|erase|find|count|swap|reset|get|at|equal_range|lower_bound|upper_bound|push_back|pop_back|front|back|data)$'
  readability-identifier-naming.PrivateMemberPrefix: m_
  readability-identifier-naming.ProtectedMemberPrefix: m_
  readability-identifier-naming.PrivateMemberCase: camelBack
  readability-identifier-naming.ProtectedMemberCase: camelBack
  readability-identifier-naming.StaticVariablePrefix: s_
  readability-identifier-naming.LocalVariableCase: camelBack
  readability-identifier-naming.ParameterCase: camelBack
  readability-identifier-naming.TemplateParameterCase: CamelCase
  readability-identifier-naming.TypeAliasIgnoredRegexp: '^[a-z_]+(_t|_type)?$'

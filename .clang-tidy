# clang-tidy configuration (proposal, docs/tasks/0054). Measured with clang-tidy 22.1.8
# against master b0991e3 at C++14; per-check hit counts and the reasoning for every
# disabled check are in docs/tasks/0054-clang-tidy-adoption.md.
#
# Run at the minimum supported standard so every suggested fix compiles there: C++14 in
# 1.x, C++17 from 2.0 (docs/tasks/0070, whose PR switches CI to 17). Checks whose fixes
# need C++20 or C++23 are off below, so clangd in a C++20/23 build does not suggest them.
# Aliases are disabled in favour of their primary check so that a hit is reported once.
# Braces around single statements are required, but enforced by .clang-format
# (InsertBraces), so readability-braces-around-statements stays off here.
Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-crtp-constructor-accessibility,
  clang-analyzer-*,
  concurrency-*,
  -concurrency-mt-unsafe,
  cppcoreguidelines-*,
  -cppcoreguidelines-avoid-c-arrays,
  -cppcoreguidelines-avoid-const-or-ref-data-members,
  -cppcoreguidelines-avoid-do-while,
  -cppcoreguidelines-avoid-magic-numbers,
  -cppcoreguidelines-avoid-non-const-global-variables,
  -cppcoreguidelines-c-copy-assignment-signature,
  -cppcoreguidelines-explicit-virtual-functions,
  -cppcoreguidelines-macro-to-enum,
  -cppcoreguidelines-macro-usage,
  -cppcoreguidelines-narrowing-conversions,
  -cppcoreguidelines-noexcept-*,
  -cppcoreguidelines-non-private-member-variables-in-classes,
  -cppcoreguidelines-owning-memory,
  -cppcoreguidelines-pro-bounds-*,
  -cppcoreguidelines-pro-type-const-cast,
  -cppcoreguidelines-pro-type-reinterpret-cast,
  -cppcoreguidelines-pro-type-static-cast-downcast,
  -cppcoreguidelines-pro-type-union-access,
  -cppcoreguidelines-pro-type-vararg,
  -cppcoreguidelines-use-default-member-init,
  -cppcoreguidelines-use-enum-class,
  google-explicit-constructor,
  misc-*,
  -misc-multiple-inheritance,
  -misc-no-recursion,
  -misc-non-private-member-variables-in-classes,
  -misc-use-internal-linkage,
  modernize-*,
  -modernize-avoid-c-arrays,
  -modernize-return-braced-init-list,
  -modernize-use-designated-initializers,
  -modernize-use-trailing-return-type,
  -modernize-use-constraints,
  -modernize-use-integer-sign-comparison,
  -modernize-use-ranges,
  -modernize-use-starts-ends-with,
  -modernize-use-std-format,
  -modernize-use-std-numbers,
  -modernize-use-std-print,
  performance-*,
  -performance-enum-size,
  portability-*,
  readability-*,
  -readability-avoid-nested-conditional-operator,
  -readability-braces-around-statements,
  -readability-container-contains,
  -readability-identifier-length,
  -readability-magic-numbers,
  -readability-named-parameter,
  -readability-redundant-casting,
  -readability-redundant-typename

# Only the project's own headers; never the FetchContent cache (an unfiltered -fix
# rewrites Boost and fmt) or the vendored files .clang-format-ignore also skips.
HeaderFilterRegex: '/(include/jinja2cpp|src)/'
ExcludeHeaderFilterRegex: '(_deps|jinja2cpp-deps|/polymorphic_value/|robin_hood\.h|lexertk\.h|unicode_tables\.h)'
FormatStyle: file
# The ratchet: every enabled check fails the pull-request job on a new hit
# (docs/tasks/0054). Compiler warnings are the build's job (-Werror there).
WarningsAsErrors: >
  *,
  -clang-diagnostic-*

CheckOptions:
  # include-cleaner (docs/tasks/0064): name the public headers of dependencies, never their
  # internals (libstdc++ bits/, Boost and nonstd detail headers, fmt's version-specific split).
  misc-include-cleaner.IgnoreHeaders: 'bits/.*;gtest/.*;gmock/.*;nlohmann/.*;.*/binding/.*;.*test_tools\.h;.*/detail/.*;fmt/.*;boost/.*;nonstd/.*;.*polymorphic_value/.*;.*lexertk\.h;.*robin_hood\.h;__.*'
  # `if (ptr)` and `if (count)` are the house idiom; flag only the surprising conversions.
  readability-implicit-bool-conversion.AllowPointerConditions: true
  readability-implicit-bool-conversion.AllowIntegerConditions: true
  # Score 25 is the upstream default; 35 functions exceed it today and carry a
  # NOLINT with their score until they are split (docs/tasks/0054).
  readability-function-cognitive-complexity.Threshold: 25
  readability-function-cognitive-complexity.IgnoreMacros: true
  readability-function-cognitive-complexity.DescribeBasicIncrements: false
  # A lone `virtual ~Base() = default;` does not need the other four.
  cppcoreguidelines-special-member-functions.AllowSoleDefaultDtor: true
  cppcoreguidelines-special-member-functions.AllowMissingMoveFunctionsWhenCopyIsDeleted: true
  # const locals only: const by-value parameters and `T* const` add noise, not safety.
  misc-const-correctness.AnalyzeValues: false
  misc-const-correctness.WarnPointersAsValues: false
  # Naming conventions as the code already uses them, for when the check is switched on
  # (src/ only; public API names such as Value::asString stay as they are).
  readability-identifier-naming.ClassCase: CamelCase
  readability-identifier-naming.StructCase: CamelCase
  readability-identifier-naming.EnumCase: CamelCase
  readability-identifier-naming.EnumConstantCase: CamelCase
  readability-identifier-naming.FunctionCase: CamelCase
  readability-identifier-naming.MethodCase: CamelCase
  # STL-shaped containers, boost::iterator_facade hooks, fmt formatters, and the public
  # Value accessors (isString, asList: include/ keeps its 1.x names, docs/tasks/0056)
  readability-identifier-naming.MethodIgnoredRegexp: '^(begin|end|cbegin|cend|rbegin|rend|size|max_size|empty|clear|reserve|contains|insert|insert_or_assign|emplace|emplace_hint|try_emplace|erase|find|count|swap|reset|get|at|equal_range|lower_bound|upper_bound|push_back|pop_back|front|back|data|increment|decrement|equal|dereference|advance|distance_to|parse|format|(is|as|get)[A-Z][A-Za-z]*)$'
  readability-identifier-naming.FunctionIgnoredRegexp: '^swap$'
  # The splitter's match kinds, prefixed to read as one family
  readability-identifier-naming.EnumConstantIgnoredRegexp: '^RM_[A-Za-z]+$'
  readability-identifier-naming.ClassConstantCase: CamelCase
  readability-identifier-naming.PrivateMemberPrefix: m_
  readability-identifier-naming.ProtectedMemberPrefix: m_
  readability-identifier-naming.PrivateMemberCase: camelBack
  readability-identifier-naming.ProtectedMemberCase: camelBack
  # s_ marks class statics and file-scope statics; a function-local static is a local
  readability-identifier-naming.ClassMemberPrefix: s_
  readability-identifier-naming.ClassMemberCase: camelBack
  readability-identifier-naming.StaticVariableCase: camelBack
  readability-identifier-naming.LocalVariableCase: camelBack
  readability-identifier-naming.ParameterCase: camelBack
  readability-identifier-naming.TypeTemplateParameterCase: CamelCase
  readability-identifier-naming.ValueTemplateParameterCase: camelBack
  readability-identifier-naming.ValueTemplateParameterIgnoredRegexp: '^[A-Z]$'
  readability-identifier-naming.TypeAliasIgnoredRegexp: '^[a-z_]+(_t|_type)?$'
